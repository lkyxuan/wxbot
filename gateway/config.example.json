{
  "listen": {
    "host": "127.0.0.1",
    "port": 8100
  },
  "api_keys": [
    "改成一串随机字符，面板里接口的 Key 填同一串"
  ],
  "llm": {
    "base_url": "https://api.deepseek.com",
    "api_key_env": "DEEPSEEK_API_KEY",
    "model": "deepseek-chat"
  },
  "mcp_servers": {
    "crypto": {
      "command": "python",
      "args": [
        "mcp_servers/crypto_server.py"
      ],
      "env": {}
    },
    "food": {
      "command": "python",
      "args": [
        "mcp_servers/food_server.py"
      ],
      "env": {}
    },
    "video": {
      "command": "python",
      "args": [
        "mcp_servers/video_server.py"
      ],
      "env": {},
      "tool_timeout": 150
    },
    "github": {
      "command": "python",
      "args": [
        "mcp_servers/github_server.py"
      ],
      "env": {}
    }
  },
  "agents": {
    "crypto": {
      "prompt_file": "agents/crypto.md",
      "mcp": [
        "crypto"
      ],
      "max_tool_rounds": 5,
      "use_client_prompt": true
    },
    "yungu-food": {
      "prompt_file": "agents/yungu-food.md",
      "mcp": [
        "food"
      ],
      "max_tool_rounds": 8,
      "use_client_prompt": true,
      "auto_reply": {
        "judge_llm": {},
        "context_messages": 8,
        "reply_when": "有人问吃什么、去哪吃、求推荐餐厅；有人问某家店怎么样、在哪、要不要排队；有人打卡（例如「打卡 店名 4分 好吃」）或明确让机器人记一家店。单纯评价一家店、分享店铺卡片、发定位但没提问的，不接话；其它闲聊不接话",
        "labels": {
          "review": "这句话在评价某家具体的店（好吃、难吃、推荐、踩雷、排队久），说去过或想去某家店，或分享了店铺卡片、定位"
        },
        "silent_on_labels": [
          "review"
        ],
        "cooldown_seconds": 0,
        "chat_when": "群友在闲聊（不是在问吃的），聊的话题你能自然、轻松地接一句，比如吃喝、天气、周末去哪、群里的趣事；单纯打招呼、表情、和你无关的私事不算",
        "chat_cooldown_seconds": 60
      }
    },
    "yungu-fitness": {
      "prompt_file": "agents/yungu-fitness.md",
      "mcp": [],
      "max_tool_rounds": 3,
      "use_client_prompt": true,
      "auto_reply": {
        "judge_llm": {},
        "context_messages": 8,
        "reply_when": "有人问健身、跑步、减肥减脂、饮食热量、拉伸恢复、作息睡眠这类问题，或向教练求建议、求计划；有人打卡、晒今天练了什么、跑了多少、体重变化；有人说没动力、想放弃、偷懒了、吃多了需要打气",
        "cooldown_seconds": 0,
        "chat_when": "群友在闲聊，话题你能自然、轻松地接一句，比如运动、户外、天气、周末安排、吃喝、身体状态、群里的趣事；单纯打招呼、表情、和你无关的私事不算",
        "chat_cooldown_seconds": 60
      }
    },
    "assistant": {
      "prompt_file": "agents/assistant.md",
      "mcp": [
        "video",
        "github"
      ],
      "max_tool_rounds": 8,
      "use_client_prompt": false
    },
    "maomao": {
      "prompt_file": "agents/maomao.md",
      "mcp": [],
      "max_tool_rounds": 3,
      "use_client_prompt": true,
      "auto_reply": {
        "judge_llm": {},
        "context_messages": 8,
        "reply_when": "有人叫猫猫、跟猫猫说话、问猫猫问题、接猫猫刚说的话；有人分享心情、求安慰、求陪聊",
        "cooldown_seconds": 0,
        "chat_when": "群友之间在闲聊，话题猫猫能自然、可爱地插一句，比如吃喝、天气、上班、周末、宠物、群里的趣事；单纯打招呼、表情不算",
        "chat_cooldown_seconds": 60
      }
    }
  }
}
