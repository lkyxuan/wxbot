{
  "listen": {
    "host": "127.0.0.1",
    "port": 8100
  },
  "api_keys": [
    "改成一串随机字符，面板里接口的 Key 填同一串"
  ],
  "public": {
    "/food-map": [
      "data/map",
      "public/food-map"
    ]
  },
  "llm": {
    "base_url": "https://api.deepseek.com",
    "api_key_env": "DEEPSEEK_API_KEY",
    "model": "deepseek-chat"
  },
  "mcp_servers": {
    "crypto": {
      "command": "python",
      "args": [
        "mcp_servers/crypto_server.py"
      ],
      "env": {}
    },
    "food": {
      "command": "python",
      "args": [
        "mcp_servers/food_server.py"
      ],
      "env": {
        "FOOD_MAP_URL": "部署网页地图后填对外访问地址，例如 https://xxx.ts.net/food-map/"
      }
    }
  },
  "agents": {
    "crypto": {
      "prompt_file": "agents/crypto.md",
      "mcp": [
        "crypto"
      ],
      "max_tool_rounds": 5,
      "use_client_prompt": true
    },
    "food": {
      "prompt_file": "agents/food.md",
      "mcp": [
        "food"
      ],
      "max_tool_rounds": 6,
      "use_client_prompt": true,
      "auto_reply": {
        "judge_llm": {},
        "context_messages": 8,
        "reply_when": "有人问吃什么、去哪吃、某家店怎么样、求推荐餐厅",
        "labels": {
          "review": "这句话在评价某家具体的店（好吃、难吃、推荐、踩雷），或分享了店铺卡片"
        },
        "silent_on_labels": [
          "review"
        ],
        "cooldown_seconds": 600
      }
    }
  }
}
