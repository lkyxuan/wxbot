<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- 网关开机自启、崩溃自动拉起。把 /Users/你的用户名/wxbot 换成实际路径，
     放到 ~/Library/LaunchAgents/ 后 launchctl load ~/Library/LaunchAgents/com.wxbot.gateway.plist。
     op run 用的 1Password 服务账号 token 由 run_gateway.sh 从登录钥匙串读取，不要写在这里。 -->
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.wxbot.gateway</string>
  <key>ProgramArguments</key>
  <array>
    <string>/Users/你的用户名/wxbot/gateway/deploy/mac/run_gateway.sh</string>
  </array>
  <key>EnvironmentVariables</key>
  <dict>
    <key>PATH</key>
    <string>/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin</string>
  </dict>
  <key>RunAtLoad</key>
  <true/>
  <key>KeepAlive</key>
  <true/>
  <key>ThrottleInterval</key>
  <integer>10</integer>
  <key>StandardOutPath</key>
  <string>/Users/你的用户名/wxbot/gateway/logs/gateway.log</string>
  <key>StandardErrorPath</key>
  <string>/Users/你的用户名/wxbot/gateway/logs/gateway.log</string>
</dict>
</plist>
